# Umiji sub page settings. Fill these in, then run: docker compose up -d

# The sub page's domain: the same as SUB_DOMAIN in the panel's .env.
SUB_DOMAIN=
# How the sub page reaches the panel:
#   panel on this server:     http://umiji:3000
#   panel on another server:  https://panel.example.com (your panel's domain)
UMIJI_PANEL_URL=
# In the panel: Umiji Settings → API Tokens → Create. Paste the token here.
UMIJI_API_TOKEN=

# Built-in HTTPS: Caddy takes ports 80 and 443 and gets and renews the certificate itself.
# Make this line COMPOSE_PROFILES= on the panel's server (the panel's Caddy serves the sub page there),
# or to use your own nginx (point it at 127.0.0.1:3010).
COMPOSE_PROFILES=caddy

# Optional sub page settings go in this file too. Copy the lines you need from
# https://github.com/therewasluna/umiji-subscription-page/blob/main/.env.sample
